# Optional Instagram Authentication Configuration
# DO NOT commit your actual .env file or share your real session credentials.
# This file is a public template -- use placeholders only.

# 1. Instagram Session ID Cookie (from your browser).
#    This is the preferred local method for Instagram view verification and
#    does NOT require a developer access token.
#    Inspect instagram.com in your browser -> DevTools (F12) -> Application
#    -> Storage -> Cookies -> instagram.com -> "sessionid"
INSTAGRAM_SESSION_ID=YOUR_INSTAGRAM_SESSION_ID_HERE

# 2. Or, if you have one, an official Meta Graph API Access Token.
#    The session id above is preferred and works without a token.
INSTAGRAM_ACCESS_TOKEN=
